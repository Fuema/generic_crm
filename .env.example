# Copy to .env.local and fill in. Never commit real values.
# This project has its own Neon database: never reuse my-tanstack-app's.

# Database (Neon Postgres)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Social sign-in (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend). Without RESEND_API_KEY, emails are printed to the dev console.
RESEND_API_KEY=
EMAIL_FROM=
