{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "generic-crm",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Uploaded files (spec §9): private, reached only through /api/files/<id>.
  // In dev, Miniflare emulates it on local disk (.wrangler/state)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "generic-crm-files" }]
}
