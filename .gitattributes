# Use LF line endings for every text file, on every OS.
# This overrides a developer's core.autocrlf setting for this repository, so
# Windows checkouts match what Biome, Vite and the route generator write and
# files no longer show up as modified when only their line endings differ.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
